// Example OpenClaw configuration for the Registrar (docs/spec/05-agent.md).
//
// Copy the parts you need into ~/.openclaw/openclaw.json5, or apply them with
// `openclaw config patch --file <this file> --dry-run` first. Nothing here is
// a secret: the bot token and the chat id belong on the host, not in this
// repository, the same way gamereg.secrets.json does.
//
// Every key below was verified against a real OpenClaw install, not just
// against the docs — the docs alone got several things wrong that mattered:
// `dmPolicy` defaults to "pairing" (anyone who finds the bot can request
// access), not blocked; `tools.exec.security` defaults to "full"
// (unrestricted shell), so the allowlist in approvals.example.json does
// nothing at all until the exec keys below are set alongside it;
// `approvals.exec` decides where an approval prompt is *routed* but not
// whether Telegram can actually *render* one — without it, a command that
// misses the allowlist fails outright with "no interactive approval client
// is currently available"; and even with routing configured,
// `channels.telegram.execApprovals.enabled` on its own, relying on
// `allowFrom` to infer the approver, was confirmed insufficient — it needs
// an explicit `approvers` list, or the failure just changes to "native chat
// exec approvals are not configured on Telegram".
//
// `amend`/`revoke` are *not* excluded from approvals.example.json's
// allowlist here, on purpose, after finding the platform approval UI
// unreliable enough in practice (see README.md, "Why amend/revoke moved
// off the platform gate") that SKILL.md's own conversational confirmation
// became the safer bet. Read that section before assuming this file is the
// stricter option.
//
// The environment gamereg needs (GAMEREG_VAULT, GAMEREG_SOURCE,
// GAMEREG_NON_INTERACTIVE) is set on the gateway *process* — see README.md.
// Do not try to set it here; this file has no mechanism that reaches exec'd
// child processes with arbitrary env vars.
{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",

      // Cheaper model for short internal tasks only — confirmed against the
      // live schema, this is scoped to things like generated session/thread
      // titles. It does not touch command interpretation, gamereg
      // invocation, or the persona: those stay on the primary model above.
      // Same auth profile as Sonnet, no separate credential needed.
      utilityModel: "anthropic/claude-haiku-4-5",
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "PUT_YOUR_BOT_TOKEN_HERE",

      // "allowlist" is the whole point — without it, dmPolicy defaults to
      // "pairing", which lets any Telegram user who finds the bot request
      // access. This is the one non-negotiable line in this file.
      dmPolicy: "allowlist",
      // Your own numeric Telegram user id, not your @username. Message the
      // bot once, then read it back from the Bot API's getUpdates, or from
      // whatever "who messaged me" tool your OpenClaw version exposes.
      allowFrom: ["PUT_YOUR_NUMERIC_CHAT_ID_HERE"],

      capabilities: {
        // Exit code 3 is rendered as inline buttons — the whole point of the
        // chat flow. "allowlist" scopes them to the senders above.
        inlineButtons: "allowlist",
      },

      // Sends through Bot API 10.1's sendRichMessage instead of sendMessage.
      // Turned on for one reason: buttons come out wider, which is what makes
      // a candidate's title readable on its own button.
      //
      // A `style` on a button does *not* need this — that was tested both
      // ways and the colours render either way. Only the width changes.
      //
      // It is not a buttons-only switch, though: it also turns on rich
      // rendering for tables and media (`supportsBlockTables`), so a query
      // result narrated as a table renders differently too. That is the whole
      // blast radius, and it is why this sits here with a reason rather than
      // being switched on for tidiness.
      richMessages: true,

      // The channel-native half of exec approvals — distinct from
      // approvals.exec below, which only decides routing. Without this,
      // routing still resolves, but Telegram itself refuses to present an
      // approval surface, and the fallback is a raw /approve command pasted
      // back at the bot, which does not work.
      //
      // `enabled: true` alone, relying on `allowFrom` above to infer the
      // approver, was tried first and confirmed insufficient — the same
      // "not configured on Telegram" failure recurred on a fresh attempt
      // afterward. The explicit `approvers` list below is what actually
      // worked: a real approval that genuinely paused and resolved on an
      // actual Telegram inline tap (exec.approval.waitDecision in the
      // gateway log, ~12s — a human reacting, not a fallback).
      execApprovals: {
        enabled: true,
        approvers: ["PUT_YOUR_NUMERIC_CHAT_ID_HERE"],
      },

      // The progress indicator shown while a gamereg command is running.
      // Telegram runs this in "progress" streaming mode by default, and the
      // default label is OpenClaw's own (lobster-themed — "Molting" is one),
      // nothing to do with a card catalog. This one is the Registrar's own
      // vocabulary instead: the same word `i18n/`'s pt-BR bundle uses for a
      // filing, not a generic status word.
      //
      // `toolProgress: false` drops the per-tool lines (`exec gamereg …`)
      // and leaves the label alone as the whole draft.
      //
      // **A fixed string on purpose, after trying a pool of eight.** `"auto"`
      // plus a `labels` array reads like it rotates. It does not: the label is
      // `labels[hashProgressSeed(seed) % labels.length]`, the seed is the
      // conversation key (`telegram:<chat id>`), and a single-user bot has
      // exactly one of those — so one label was drawn and it never changed
      // again. The random branch beside it only runs when there is no seed. A
      // pool earns its keep across *different* chats; here it was eight
      // strings pretending, seven of which no one would ever see.
      //
      // **`mode: "progress"` must be written out even though Telegram
      // already defaults to it.** `resolveChannelStreamingPreviewToolProgress`
      // only consults `progress.*` when the mode *resolves* to "progress",
      // and its resolver falls back to "partial" when `streaming.mode` is
      // absent from config — the channel default never reaches it. Set
      // `toolProgress` without `mode` and it is silently read as
      // partial-mode config and ignored: no error, no log line, commands
      // still on screen. `commandText` is a separate knob and already
      // defaults to "status"; setting it changes nothing here.
      streaming: {
        mode: "progress",
        progress: {
          label: "📋 Protocolando",
          toolProgress: false,
          commandText: "status",
        },
      },
    },
  },

  // Where an approval prompt actually gets delivered when tools.exec.ask
  // below needs one. Without this block, a command that misses the
  // allowlist doesn't wait for you — it fails immediately, with no route to
  // ask. "session" sends the prompt back into whatever chat the command
  // came from, which for a single-owner DM bot is the only sensible choice;
  // there's no separate ops room to route it to instead.
  approvals: {
    exec: {
      enabled: true,
      mode: "session",
    },
  },

  tools: {
    // Governs whether the agent may run gamereg at all, and what happens to
    // anything not on the allowlist in approvals.example.json.
    //
    // security: "allowlist" — only allowlisted patterns run; everything else
    // is subject to `ask`. Leaving this unset means "full": every command
    // runs with no gate whatsoever, allowlist file or not.
    //
    // ask: "off" — anything that isn't allowlisted (a chained command that
    // doesn't match the plain `gamereg` pattern, or a tool other than
    // gamereg entirely) is denied immediately, with no prompt and no wait.
    // The agent's own boundary is "gamereg, one invocation, nothing else"
    // (SKILL.md), so a miss here is always a mistake to recover from, never
    // something a human is expected to approve — `on-miss` used to route
    // that decision to chat instead, and in practice it only ever produced
    // an approval nobody asked for, sometimes minutes of it. `amend` and
    // `revoke` are on the allowlist in approvals.example.json like every
    // other gamereg command; their confirmation is conversational, in
    // SKILL.md, not this gate — see README.md for why, and what that trades
    // away. `approvals.exec` below is dead weight with `ask: "off"` (nothing
    // ever asks), kept only in case a future change reintroduces a real
    // approval path.
    exec: {
      security: "allowlist",
      ask: "off",
    },

    media: {
      // Voice notes are transcribed here, upstream of gamereg. The CLI never
      // touches audio and must never be asked to.
      audio: { enabled: true },

      models: [
        // Pick one. Transcribed game titles are unreliable either way, which
        // is what the alias table exists for — the user corrects a mangled
        // title once and the register remembers.
        //
        // Hosted: better on pt-BR out of the box, but the audio leaves the
        // machine.
        {
          provider: "openrouter",
          model: "openai/whisper-large-v3-turbo",
          capabilities: ["audio"],
        },

        // Local: nothing leaves the host, no per-minute cost, more setup.
        // There is no "whisper-local" provider — OpenClaw has no such
        // provider id. Local Whisper is a CLI entry that shells out to
        // `whisper-cli` (the `whisper-cpp` binary) directly; OpenClaw's own
        // audio auto-detect falls back to this same binary if one is on
        // PATH, but an explicit entry is what lets `-l pt` and `-t` be set.
        // `-l pt` forces the language instead of paying for auto-detect (and
        // occasionally mis-detecting) on every note. Verified end-to-end on
        // a real install (whisper.cpp built from source,
        // ggml-large-v3-turbo-q5_0.bin, `-t 12`) against a short voice note
        // transcribed correctly in pt-BR — the longer session-closing smoke
        // test in README.md's "Voice" section is still open. `ffmpeg` must
        // also be on PATH; OpenClaw uses it to decode the incoming audio
        // before handing it to whisper-cli, and fails with a clear "ffmpeg
        // not found" reason if it's missing.
        // {
        //   type: "cli",
        //   command: "whisper-cli",
        //   args: [
        //     "-m", "/path/to/ggml-large-v3-turbo-q5_0.bin",
        //     "-l", "pt",
        //     "-nt",
        //     "-t", "12",
        //     "{{MediaPath}}",
        //   ],
        //   timeoutSeconds: 60,
        //   capabilities: ["audio"],
        // },
      ],
    },
  },
}
