// Example OpenClaw configuration for the Registrar (docs/spec/05-agent.md).
//
// Copy the parts you need into ~/.openclaw/openclaw.json5, or apply them with
// `openclaw config patch --file <this file> --dry-run` first. Nothing here is
// a secret: the bot token and the chat id belong on the host, not in this
// repository, the same way gamereg.secrets.json does.
//
// Every key below was verified against a real OpenClaw install, not just
// against the docs — the docs alone got several things wrong that mattered:
// `dmPolicy` defaults to "pairing" (anyone who finds the bot can request
// access), not blocked; `tools.exec.security` defaults to "full"
// (unrestricted shell), so the allowlist in approvals.example.json does
// nothing at all until the exec keys below are set alongside it;
// `approvals.exec` decides where an approval prompt is *routed* but not
// whether Telegram can actually *render* one — without it, a command that
// misses the allowlist fails outright with "no interactive approval client
// is currently available"; and even with routing configured,
// `channels.telegram.execApprovals.enabled` on its own, relying on
// `allowFrom` to infer the approver, was confirmed insufficient — it needs
// an explicit `approvers` list, or the failure just changes to "native chat
// exec approvals are not configured on Telegram".
//
// `amend`/`revoke` are *not* excluded from approvals.example.json's
// allowlist here, on purpose, after finding the platform approval UI
// unreliable enough in practice (see README.md, "Why amend/revoke moved
// off the platform gate") that SKILL.md's own conversational confirmation
// became the safer bet. Read that section before assuming this file is the
// stricter option.
//
// The environment gamereg needs (GAMEREG_VAULT, GAMEREG_SOURCE,
// GAMEREG_NON_INTERACTIVE) is set on the gateway *process* — see README.md.
// Do not try to set it here; this file has no mechanism that reaches exec'd
// child processes with arbitrary env vars.
{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "PUT_YOUR_BOT_TOKEN_HERE",

      // "allowlist" is the whole point — without it, dmPolicy defaults to
      // "pairing", which lets any Telegram user who finds the bot request
      // access. This is the one non-negotiable line in this file.
      dmPolicy: "allowlist",
      // Your own numeric Telegram user id, not your @username. Message the
      // bot once, then read it back from the Bot API's getUpdates, or from
      // whatever "who messaged me" tool your OpenClaw version exposes.
      allowFrom: ["PUT_YOUR_NUMERIC_CHAT_ID_HERE"],

      capabilities: {
        // Exit code 3 is rendered as inline buttons — the whole point of the
        // chat flow. "allowlist" scopes them to the senders above.
        inlineButtons: "allowlist",
      },

      // The channel-native half of exec approvals — distinct from
      // approvals.exec below, which only decides routing. Without this,
      // routing still resolves, but Telegram itself refuses to present an
      // approval surface, and the fallback is a raw /approve command pasted
      // back at the bot, which does not work.
      //
      // `enabled: true` alone, relying on `allowFrom` above to infer the
      // approver, was tried first and confirmed insufficient — the same
      // "not configured on Telegram" failure recurred on a fresh attempt
      // afterward. The explicit `approvers` list below is what actually
      // worked: a real approval that genuinely paused and resolved on an
      // actual Telegram inline tap (exec.approval.waitDecision in the
      // gateway log, ~12s — a human reacting, not a fallback).
      execApprovals: {
        enabled: true,
        approvers: ["PUT_YOUR_NUMERIC_CHAT_ID_HERE"],
      },

      // The progress indicator shown while a gamereg command is running.
      // Telegram runs this in "progress" streaming mode by default; the
      // default label pool is OpenClaw's own (lobster-themed — "Molting" is
      // one of them), nothing to do with a card catalog. This pool replaces
      // it with the Registrar's own vocabulary instead — same register as
      // SOUL.md's filed/protocolada table, not a generic status word.
      streaming: {
        progress: {
          label: "auto",
          labels: [
            "📋 Protocolando",
            "🗂️ Arquivando",
            "🖋️ Carimbando",
            "🔍 Consultando",
            "🗃️ Catalogando",
            "📎 Anexando",
            "🔖 Registrando",
            "📜 Conferindo",
          ],
        },
      },
    },
  },

  // Where an approval prompt actually gets delivered when tools.exec.ask
  // below needs one. Without this block, a command that misses the
  // allowlist doesn't wait for you — it fails immediately, with no route to
  // ask. "session" sends the prompt back into whatever chat the command
  // came from, which for a single-owner DM bot is the only sensible choice;
  // there's no separate ops room to route it to instead.
  approvals: {
    exec: {
      enabled: true,
      mode: "session",
    },
  },

  tools: {
    // Governs whether the agent may run gamereg at all, and what happens to
    // anything not on the allowlist in approvals.example.json.
    //
    // security: "allowlist" — only allowlisted patterns run; everything else
    // is subject to `ask`. Leaving this unset means "full": every command
    // runs with no gate whatsoever, allowlist file or not.
    //
    // ask: "on-miss" — anything that isn't allowlisted (a chained command
    // that doesn't match the plain `gamereg` pattern, or a tool other than
    // gamereg entirely) pauses for a human decision instead of running or
    // failing silently — but only because approvals.exec below tells
    // OpenClaw where to send that prompt. `amend` and `revoke` are on the
    // allowlist in approvals.example.json like every other gamereg command;
    // their confirmation is conversational, in SKILL.md, not this gate — see
    // README.md for why, and what that trades away.
    exec: {
      security: "allowlist",
      ask: "on-miss",
    },

    media: {
      // Voice notes are transcribed here, upstream of gamereg. The CLI never
      // touches audio and must never be asked to.
      audio: { enabled: true },

      models: [
        // Pick one. Transcribed game titles are unreliable either way, which
        // is what the alias table exists for — the user corrects a mangled
        // title once and the register remembers.
        //
        // Hosted: better on pt-BR out of the box, but the audio leaves the
        // machine.
        {
          provider: "openrouter",
          model: "openai/whisper-large-v3-turbo",
          capabilities: ["audio"],
        },

        // Local: nothing leaves the host, no per-minute cost, more setup.
        // Not yet verified against a real install — check the provider
        // spelling against your OpenClaw version before relying on it.
        // {
        //   provider: "whisper-local",
        //   model: "large-v3",
        //   capabilities: ["audio"],
        // },
      ],
    },
  },
}
