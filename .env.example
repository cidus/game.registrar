# Copy to .env and fill in. `.env` is gitignored and holds secrets; this file
# is committed and holds none.
#
# Everything here is a prerequisite or a secret. Everything that is merely a
# preference -- timezone, platforms, which targets -- has a default and can be
# changed later with `gamereg` itself. The system works with none of the
# optional values set.

# --- required ----------------------------------------------------------------

# From @BotFather. Also run /setjoingroups and disable it: this is a DM-only bot.
TELEGRAM_BOT_TOKEN=

# Your *numeric* chat id, not an @username -- a username passes validation and
# then matches nobody, so every message would be refused in silence.
#
# You can leave this empty. The stack then starts in pairing mode, and the bot
# replies to your first message with your own numeric id, a one-time code, and
# the command that approves it. That is the only way to learn the id at all:
# no Telegram client shows it, and the Bot API will not resolve a @username.
#
# Fill it in and restart for a fully closed door; leave it empty and approve
# the code instead. Both work. They are two paths and not two steps -- with
# this set, the pairing store is ignored.
TELEGRAM_ALLOW_FROM=

# The model behind the agent. Without it the gateway starts cleanly, the
# channel connects, and nothing ever answers -- so this is required in
# practice even though nothing refuses to boot without it.
#
# OPENCLAW_AUTH_CHOICE picks the provider: `apiKey` for Anthropic,
# `openrouter-api-key` for OpenRouter. `openclaw onboard --help` lists every
# other option this install accepts.
# Two shapes are accepted and the first one present wins.
#
# A Claude Code OAuth token needs no onboarding -- it is read from the
# environment by an `anthropic:cli` auth profile, which the entrypoint writes.
CLAUDE_CODE_OAUTH_TOKEN=

# Or a plain API key, provisioned through `openclaw onboard`. `apiKey` is
# Anthropic; `openrouter-api-key` is OpenRouter.
OPENCLAW_AUTH_CHOICE=apiKey
OPENCLAW_AUTH_KEY=

# Used as the model fallback, and by the hosted voice transcription the seeded
# config selects. Local Whisper needs ~550 MB for the model alone and does not
# fit on a 1 GB machine.
OPENROUTER_API_KEY=

# --- paths on the host -------------------------------------------------------

# The vault. A bind mount, never a named volume: it is a git repository you
# push, and you may well want to open it in Obsidian from somewhere else.
GAMEREG_VAULT_PATH=./vault

# Gateway state: config, workspace, exec allowlist, cron store, transcripts.
GAMEREG_CONFIG_PATH=./config

# A deploy key for the vault's git remote, plus a known_hosts. Mounted
# read-only. Without a remote configured the push is simply skipped.
GAMEREG_SSH_PATH=./config/ssh

# Own the bind mounts as yourself, so the vault does not end up root-owned.
#   PUID=$(id -u)  PGID=$(id -g)
PUID=1000
PGID=1000

# --- optional ----------------------------------------------------------------

# Metadata and cover art. Missing, `enrich` reports the provider unavailable
# and exits 6, which still commits whatever local work it did. Everything else
# works untouched.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Applied only when the vault is first initialised. Afterwards the vault's own
# gamereg.config.json wins and these are ignored.
GAMEREG_TIMEZONE=America/Sao_Paulo
GAMEREG_LOCALE=pt-BR
GAMEREG_DAY_CUTOFF=05:00
GAMEREG_TARGETS=obsidian,csv,sqlite,json,html,stats,quartz

# Who the vault's automated commits are attributed to. `git commit` aborts
# outright without an identity, which is a failure that only shows up at the
# first maintenance tick.
GAMEREG_GIT_NAME=gamereg
GAMEREG_GIT_EMAIL=gamereg@localhost

# How often to enrich, build and commit. Seconds.
GAMEREG_AUTOBUILD_INTERVAL=600

# Check-in delivery. Without routing the questions still arrive, but as plain
# text with no inline buttons, so the answers have to be typed.
GAMEREG_CHECKIN_CHANNEL=telegram
GAMEREG_CHECKIN_TO=
GAMEREG_CHECKIN_CRON=0 * * * *

# --- memory ------------------------------------------------------------------
#
# Defaults are sized for a 1 GB machine. Raise them on anything larger.
GATEWAY_MEM_LIMIT=480m
MAINTENANCE_MEM_LIMIT=256m

# --- profile: site -----------------------------------------------------------
#
# Only read when you run `docker compose --profile site up -d`. Do not turn
# this on with 1 GB of RAM and 1 GB of monthly egress; build the site from the
# repository the maintenance loop pushes instead. See docs/deploy-container.md.
#
# Requires that scripts/vendor-quartz.sh has already run against the vault:
# gamereg emits Quartz's input and never runs Quartz.
SITE_BIND=127.0.0.1
SITE_PORT=8080
SITE_BUILD_MEM_LIMIT=768m
GAMEREG_SITE_INTERVAL=300

# Serve the comments under the site's own origin, at /remark42/. Set this only
# when the `comments` profile runs on this machine too.
#
# One published port instead of two, and no CORS allowlist to keep in step with
# the site's address. Leave it empty when comments live elsewhere, or not at
# all, or when OAuth sign-in is configured — under a subpath those links can
# lose the prefix (umputun/remark42#961), and a separate port avoids it.
#
# REMARK_URL below must then carry the same path.
SITE_COMMENTS_UPSTREAM=remark42:8080

# --- profile: comments -------------------------------------------------------
#
# Only read when you run `docker compose --profile comments up -d`.
#
# REMARK_URL is the address a browser will use, and it must match the `host`
# the plugin is given in the vault's quartz/quartz.config.yaml. A mismatch
# fails in silence: the widget loads from one address while Remark42 believes
# it lives at another.
#
#   comments proxied under a local site   http://127.0.0.1:8080/remark42
#   comments behind the tunnel            https://comments.example.com
#
# REMARK_SECRET signs the JWTs: make it long and random (`openssl rand -hex 32`)
# and treat it as a secret.
REMARK_URL=
REMARK_SECRET=
REMARK_SITE=gamereg
REMARK_ADMIN_ID=

# --- profile: tunnel ---------------------------------------------------------
#
# Only read with `--profile tunnel`, which you need when something outside this
# machine has to reach in — a site served by Cloudflare commenting against a
# Remark42 that lives here. With the site local too, skip it: site-serve
# already fronts both on one origin.
#
# From `cloudflared tunnel` in the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
