filters:
  and:
    - file.inFolder("runs")
    - file.hasTag("gamereg")
properties:
  title:
    displayName: {{base.column.game}}
  completion_criteria:
    displayName: {{base.column.criteria}}
  hours_source:
    displayName: {{base.column.hours_source}}
views:
  - type: table
    name: {{base.view.finished}}
    filters:
      and:
        - 'status == "finished"'
    order:
      - title
      - platform
      - ended_on
      - hours
      - rating
      - difficulty
      - completion_criteria
    sort:
      - property: ended_on
        direction: DESC
    summaries:
      hours: Sum
  - type: table
    name: {{base.view.playing}}
    filters:
      and:
        - 'status == "playing"'
    order:
      - title
      - platform
      - started_on
      - hours
      - sessions
    sort:
      - property: started_on
        direction: DESC
  - type: table
    name: {{base.view.by_genre}}
    groupBy:
      property: genres
      direction: ASC
    order:
      - title
      - platform
      - ended_on
      - hours
      - rating
    sort:
      - property: rating
        direction: DESC
    summaries:
      hours: Sum
  - type: table
    name: {{base.view.dropped}}
    filters:
      and:
        - 'status == "abandoned"'
    order:
      - title
      - platform
      - ended_on
      - hours
      - rating
  - type: cards
    name: {{base.view.shelf}}
    filters:
      and:
        - 'status != "playing"'
    image: cover
    order:
      - title
      - platform
      - rating
    sort:
      - property: ended_on
        direction: DESC
